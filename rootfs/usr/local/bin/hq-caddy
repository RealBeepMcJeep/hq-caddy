#!/usr/bin/python3
"""hq-caddy: a standalone Caddy proxy whose site files come from a Git repository.

Every HQ_POLL_SECONDS it fetches the config repository, builds a complete Caddy
configuration from its sites/ and tcp/ files, validates it, and reloads Caddy.
An invalid commit is never applied: the running configuration stays, and the
commit gets a failed status (Gitea API) plus a banner on the sites page.

Settings (environment):
  PROXY_DOMAIN               the domain: https://<name>.<domain>, with a Let's
                             Encrypt wildcard certificate via Cloudflare DNS-01
  CLOUDFLARE_API_TOKEN       Cloudflare token (Zone DNS edit), or
  CLOUDFLARE_API_TOKEN_FILE  a file holding it
  HQ_CONFIG_REPO             Git URL of the config repository (https:// or file://)
  HQ_CONFIG_BRANCH           branch to follow (default main)
  HQ_CONFIG_USER             username for HTTPS fetches (default hq-caddy)
  HQ_CONFIG_TOKEN_FILE       token for HTTPS fetches and commit statuses
  HQ_CONFIG_DIR              instead of a repository: a mounted folder, re-read on change
  HQ_POLL_SECONDS            seconds between fetches (default 30, min 5)
  HQ_STATUS_CONTEXT          name of the commit status (default hq-caddy)
  HQ_TLS                     "internal": certificates from Caddy's local CA (tests)
  HQ_RELAY                   host:port of a relay for services that listen only on
                             loopback on another box (see `relay` below)
  PROXY_BIND                 addresses to listen on, comma/space separated (default all)
  PROXY_HTTP_PORT/PROXY_HTTPS_PORT  listener ports (default 80/443)
  PROXY_MANAGE_DNS           true: create missing *.<host>.<domain> A records for
                             <service>.<host> sites (create-only)
  PROXY_DNS_TARGET           address for those records (default: first IPv4 PROXY_BIND)
  HQ_DNS_RECORDS             true: keep the zone's records in line with dns/records (below)
  PROXY_CHECK_INTERVAL       seconds between status checks of one site (default 300, min 60)

Config repository layout:
  sites/<name>.caddy   one site: `import proxy <name> <upstream>` or
                       `import site <name> { ... }` with any Caddy directives
  tcp/<name>.caddy     raw TCP: `import forward <port> <upstream>`
  Through HQ_RELAY:    `import relay <name> <port>`, `import relay_upstream <port>`
                       (inside `import site`), `import relay_files <name>` (static),
                       `import relay_root <folder>` (files from a folder on the relay's box)
  dns/records          DNS records under the domain, one per line: `<name> <A|AAAA|CNAME> <value>`
                       (`@` is the domain itself). Applied with HQ_DNS_RECORDS: creates and
                       updates them, deletes only records it created (tagged in their comment),
                       and never changes any other record. Without the file, nothing is managed.
  A `# check: ...` line in a file defines its status check (see the README).

Commands:
  run        build and run Caddy, the sync loop and the status checks (the default)
  status     the applied commit, the last sync result and Caddy's state
  show       print the active Caddy configuration
  checks     list every status check result
  sync       fetch and apply now instead of waiting for the next poll
  dns        the last dns/records result (--plan: compute the changes now, apply nothing;
             works before HQ_DNS_RECORDS is turned on)
  check DIR  build and validate DIR (a checkout of the config repository) without applying
  --version  print the hq-caddy and Caddy versions
"""
import base64
import hashlib
import html
import ipaddress
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

VERSION = "0.3.2"
STATE = Path(os.environ.get("HQ_STATE_DIR", "/data/hq-caddy"))
ACTIVE = STATE / "active"
CANDIDATE = STATE / "candidate"
REPO = STATE / "repo"
LOG = STATE / "caddy.log"
REPORT = STATE / "report.json"
STATUS = STATE / "status.json"
DNS_LIST = STATE / "dns.json"
SYNC = STATE / "sync.json"
SYNC_NOW = STATE / "sync-now"
RECORDS_STATE = STATE / "records.json"
RECORDS_TAG = "hq-caddy records"  # comment prefix of records it manages; nothing else is ever changed
ADMIN = os.environ.get("HQ_ADMIN", "localhost:2019")  # Caddy admin API, inside the container only
RESERVED = {"sites"}
NAME = re.compile(r"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$")
CHECK_LINE = re.compile(r"^\s*#\s*check:\s*(.*?)\s*$", re.M)
CHECK_TIMEOUT = 10  # seconds per check
DOMAIN = re.compile(r"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$")


def env(name, default=""):
    return os.environ.get(name, default).strip()


def number(name, default, minimum):
    value = env(name, str(default))
    return max(minimum, int(value)) if value.isdigit() else default


def settings():
    public = env("PROXY_DOMAIN").lower().rstrip(".")
    bind = [a for a in re.split(r"[,\s]+", env("PROXY_BIND")) if a]
    return {
        "public": public if DOMAIN.match(public) else "",
        "tls_internal": env("HQ_TLS").lower() == "internal",
        "bind": bind,
        "http_port": env("PROXY_HTTP_PORT", "80"),
        "https_port": env("PROXY_HTTPS_PORT", "443"),
        "repo": env("HQ_CONFIG_REPO"),
        "branch": env("HQ_CONFIG_BRANCH", "main"),
        "user": env("HQ_CONFIG_USER", "hq-caddy"),
        "repo_token_file": env("HQ_CONFIG_TOKEN_FILE"),
        "config_dir": env("HQ_CONFIG_DIR"),
        "relay": env("HQ_RELAY"),
        "poll": number("HQ_POLL_SECONDS", 30, 5),
        "check_interval": number("PROXY_CHECK_INTERVAL", 300, 60),
        "manage_dns": env("PROXY_MANAGE_DNS").lower() in ("1", "true", "yes", "on"),
        "manage_records": env("HQ_DNS_RECORDS").lower() in ("1", "true", "yes", "on"),
        "dns_target": env("PROXY_DNS_TARGET") or next((a for a in bind if re.fullmatch(r"[0-9.]+", a)), ""),
    }


def read_secret(variable, file_variable):
    if env(variable):
        return env(variable)
    try:
        return Path(env(file_variable)).read_text().strip() if env(file_variable) else ""
    except OSError:
        return ""


def token():
    return read_secret("CLOUDFLARE_API_TOKEN", "CLOUDFLARE_API_TOKEN_FILE")


def caddy_env():
    """Environment for Caddy: the token is passed by variable, never written to config."""
    environment = dict(os.environ)
    if token():
        environment["CLOUDFLARE_API_TOKEN"] = token()
    return environment


def log(message):
    print(f"hq-caddy: {message}", file=sys.stderr, flush=True)


# ----- site files ---------------------------------------------------------------

def collect(source):
    """Site and tcp files in a config checkout; names that can't be served are skipped."""
    sites, skipped, tcp = [], [], []
    for path in sorted((source / "sites").glob("*.caddy")) if (source / "sites").is_dir() else []:
        name, entry = path.stem, {"name": path.stem, "source": f"sites/{path.name}", "path": str(path)}
        if name in RESERVED:
            skipped.append(dict(entry, reason="reserved name"))
        elif not NAME.match(name):
            skipped.append(dict(entry, reason="invalid name (a-z, 0-9, -, dots between labels)"))
        else:
            sites.append(dict(entry, check=check_line(path)))
    for path in sorted((source / "tcp").glob("*.caddy")) if (source / "tcp").is_dir() else []:
        tcp.append({"name": path.stem, "source": f"tcp/{path.name}", "path": str(path),
                    "ports": forward_ports(path), "check": check_line(path)})
    return sites, skipped, tcp


def check_line(path):
    """The status check defined by a `# check: ...` line ("" when there is none)."""
    try:
        found = CHECK_LINE.search(Path(path).read_text())
    except OSError:
        return ""
    return found.group(1) if found else ""


def forward_ports(path):
    """Ports named by `import forward PORT UPSTREAM` lines (for listings only)."""
    try:
        return [f"{m.group(1)} -> {m.group(2)}" for m in
                re.finditer(r"^\s*import\s+forward\s+(\d+)\s+(\S+)", path.read_text(), re.M)]
    except OSError:
        return []


def cloudflare(method, path, data=None):
    api = env("HQ_CLOUDFLARE_API", "https://api.cloudflare.com/client/v4")  # override for tests only
    req = urllib.request.Request(api + path, method=method,
                                 data=json.dumps(data).encode() if data is not None else None,
                                 headers={"Authorization": f"Bearer {token()}", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=15) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        return json.load(error)


def zone_id(cfg):
    """Cloudflare zone of PROXY_DOMAIN; the zone may be a parent of it."""
    labels = cfg["public"].split(".")
    for i in range(len(labels) - 1):
        found = cloudflare("GET", "/zones?name=" + ".".join(labels[i:])).get("result") or []
        if found:
            return found[0]["id"]
    return None


def ensure_dns(cfg, names):
    """Create missing *.<host>.<domain> A records. Create-only; returns per-host results."""
    if not (cfg["manage_dns"] and cfg["public"] and names):
        return []
    if not cfg["dns_target"]:
        return [{"name": "*", "state": "error: set PROXY_DNS_TARGET (or an IPv4 PROXY_BIND)"}]
    results = []
    try:
        zone = zone_id(cfg)
        if not zone:
            return [{"name": "*", "state": f"error: no Cloudflare zone found for {cfg['public']}"}]
        for host in names:
            fqdn = f"*.{host}.{cfg['public']}"
            existing = cloudflare("GET", f"/zones/{zone}/dns_records?name={fqdn}").get("result") or []
            if existing:
                results.append({"name": fqdn, "state": "exists"})
                continue
            made = cloudflare("POST", f"/zones/{zone}/dns_records", {
                "type": "A", "name": fqdn, "content": cfg["dns_target"], "proxied": False, "ttl": 1,
                "comment": f"hq-caddy: services on {host} (<service>.{host}.{cfg['public']})"})
            state = "created" if made.get("success") else "error: " + "; ".join(
                e.get("message", "?") for e in made.get("errors", []))
            results.append({"name": fqdn, "state": state})
    except (OSError, ValueError) as error:
        results.append({"name": "*", "state": f"error: {type(error).__name__}"})
    return results


# ----- DNS records file (dns/records) --------------------------------------------

RECORD_NAME = re.compile(r"^(@|(\*\.)?[a-z0-9_]([a-z0-9_-]{0,61}[a-z0-9_])?(\.[a-z0-9_]([a-z0-9_-]{0,61}[a-z0-9_])?)*|\*)$")


def parse_records(text, domain):
    """dns/records lines -> (records, errors). A record: name, type, value, note."""
    records, errors = [], []
    for number, raw in enumerate(text.splitlines(), 1):
        line, _, note = raw.partition("#")
        fields = line.split()
        if not fields:
            continue
        if len(fields) != 3:
            errors.append(f"line {number}: expected `<name> <type> <value>`")
            continue
        name, kind, value = fields[0].lower(), fields[1].upper(), fields[2]
        if not RECORD_NAME.match(name):
            errors.append(f"line {number}: invalid name {name!r} (relative to the domain; @ for the domain)")
            continue
        try:
            if kind == "A":
                value = str(ipaddress.IPv4Address(value))
            elif kind == "AAAA":
                value = str(ipaddress.IPv6Address(value))
            elif kind == "CNAME":
                value = value.lower().rstrip(".")
                if not DOMAIN.match(value):
                    raise ValueError
            else:
                errors.append(f"line {number}: type {kind} not supported (A, AAAA, CNAME)")
                continue
        except ValueError:
            errors.append(f"line {number}: invalid {kind} value {value!r}")
            continue
        fqdn = domain if name == "@" else f"{name}.{domain}"
        if any(r["name"] == fqdn and r["type"] == kind and r["value"] == value for r in records):
            errors.append(f"line {number}: duplicate of an earlier line")
            continue
        records.append({"name": fqdn, "type": kind, "value": value, "note": note.strip()})
    for fqdn in {r["name"] for r in records if r["type"] == "CNAME"}:
        if sum(r["name"] == fqdn for r in records) > 1:
            errors.append(f"{fqdn}: a CNAME can't share its name with other records")
    return records, errors


def records_file(folder):
    path = Path(folder) / "dns" / "records"
    return path if path.is_file() else None


def record_comment(note):
    return (f"{RECORDS_TAG}: {note}" if note else RECORDS_TAG)[:100]  # Cloudflare's comment limit


def zone_records(zone):
    """Every record of the zone (the list API pages at 500)."""
    records, page = [], 1
    while True:
        answer = cloudflare("GET", f"/zones/{zone}/dns_records?per_page=500&page={page}")
        if not answer.get("success"):
            raise ValueError("; ".join(e.get("message", "?") for e in answer.get("errors", [])) or "request failed")
        records += answer["result"]
        if page >= (answer.get("result_info") or {}).get("total_pages", 1):
            return records
        page += 1


def plan_records(wanted, existing):
    """The changes that bring the zone in line with dns/records, touching only records that
    carry RECORDS_TAG or that it adopts (same name, type and value). Returns (changes, conflicts)."""
    managed = lambda r: (r.get("comment") or "").startswith(RECORDS_TAG)
    changes, conflicts = [], []
    keys = sorted({(w["name"], w["type"]) for w in wanted})
    for name, kind in keys:
        want = {w["value"]: w for w in wanted if (w["name"], w["type"]) == (name, kind)}
        here = [r for r in existing if r["name"] == name and r["type"] == kind]
        others = [r for r in existing if r["name"] == name and r["type"] != kind and not managed(r)
                  and (kind == "CNAME" or r["type"] == "CNAME")]
        strangers = [r for r in here if not managed(r) and r["content"] not in want]
        if strangers or others:
            for r in strangers + others:
                conflicts.append(f"{name} {r['type']} {r['content']} exists and isn't managed by hq-caddy "
                                 "(remove it, or list that value)")
            continue  # leave this name alone until resolved
        spare = []
        for record in here:
            item = want.pop(record["content"], None)
            if item is None:
                spare.append(record)  # managed, value no longer listed
            elif record.get("comment") != record_comment(item["note"]) or record.get("proxied"):
                changes.append({"action": "adopt" if not managed(record) else "update", "id": record["id"],
                                "name": name, "type": kind, "value": item["value"], "note": item["note"]})
        for item in want.values():
            if spare:
                record = spare.pop()
                changes.append({"action": "update", "id": record["id"], "name": name, "type": kind,
                                "value": item["value"], "note": item["note"], "was": record["content"]})
            else:
                changes.append({"action": "create", "name": name, "type": kind, "value": item["value"],
                                "note": item["note"]})
        changes += [{"action": "delete", "id": r["id"], "name": name, "type": kind, "value": r["content"]} for r in spare]
    listed = set(keys)
    changes += [{"action": "delete", "id": r["id"], "name": r["name"], "type": r["type"], "value": r["content"]}
                for r in existing if managed(r) and (r["name"], r["type"]) not in listed]
    # Deletes first, so a type change (e.g. A -> CNAME) never collides.
    return sorted(changes, key=lambda c: c["action"] != "delete"), conflicts


RECORDS_LOCK = threading.Lock()


def reconcile_records(cfg, folder, apply_changes=True):
    """Apply dns/records from folder; write and return the result."""
    path = records_file(folder)
    result = {"at": int(time.time()), "changes": [], "conflicts": [], "error": ""}
    if not path:
        result["note"] = "no dns/records file: no records managed"
    elif apply_changes and not cfg["manage_records"]:
        result["note"] = "dns/records present, but HQ_DNS_RECORDS is off"
    elif not (cfg["public"] and token()):
        result["error"] = "dns/records needs PROXY_DOMAIN and a Cloudflare token"
    else:
        wanted, errors = parse_records(path.read_text(), cfg["public"])
        with RECORDS_LOCK:
            try:
                if errors:
                    raise ValueError("dns/records: " + "; ".join(errors))
                zone = zone_id(cfg)
                if not zone:
                    raise ValueError(f"no Cloudflare zone found for {cfg['public']}")
                changes, result["conflicts"] = plan_records(wanted, zone_records(zone))
                for change in changes:
                    done = "planned"
                    if apply_changes:
                        body = {"type": change["type"], "name": change["name"], "content": change["value"],
                                "proxied": False, "ttl": 1, "comment": record_comment(change.get("note", ""))}
                        answer = (cloudflare("DELETE", f"/zones/{zone}/dns_records/{change['id']}")
                                  if change["action"] == "delete" else
                                  cloudflare("POST", f"/zones/{zone}/dns_records", body) if change["action"] == "create" else
                                  cloudflare("PATCH", f"/zones/{zone}/dns_records/{change['id']}", body))
                        done = "done" if answer.get("success") else "failed: " + "; ".join(
                            e.get("message", "?") for e in answer.get("errors", []))
                        if done == "done":
                            log(f"DNS {change['action']} {change['name']} {change['type']} {change['value']}")
                    result["changes"].append(dict(change, state=done))
            except (OSError, ValueError, KeyError) as error:
                result["error"] = f"{type(error).__name__}: {error}"[:300]
    if apply_changes:
        write_json(RECORDS_STATE, result)
    return result


def records_ok(result):
    return not (result.get("error") or result.get("conflicts")
                or any(c["state"].startswith("failed") for c in result.get("changes", [])))


def records_summary(result):
    """One line for the commit status ("" when records aren't managed or nothing changed)."""
    if result.get("error"):
        return "DNS error: " + result["error"]
    failed = [c for c in result.get("changes", []) if c["state"].startswith("failed")]
    if failed or result.get("conflicts"):
        return "DNS: " + "; ".join([f"{c['action']} {c['name']} {c['state']}" for c in failed] + result.get("conflicts", []))
    counts = {}
    for change in result.get("changes", []):
        counts[change["action"]] = counts.get(change["action"], 0) + 1
    return ("DNS: " + ", ".join(f"{n} {a}" for a, n in sorted(counts.items()))) if counts else ""


# ----- configuration ---------------------------------------------------------

def quote(value):
    return '"' + str(value).replace("\\", "\\\\").replace('"', '\\"') + '"'


def dns_hosts(cfg):
    """Hosts with a *.<host>.<domain> record pointing here: their names get the 404 page
    (and a certificate) even when no site file uses that host."""
    here = set(cfg["bind"]) | {cfg["dns_target"]}
    suffix = "." + cfg["public"]
    found = set()
    for record in load_json(DNS_LIST).get("records", []):
        name = record["name"]
        if name.startswith("*.") and name.endswith(suffix) and record["address"] in here:
            host = name[2:-len(suffix)]
            if host and DOMAIN.match(host):
                found.add(host)
    return found


def caddyfile(cfg, sites, tcp, host_names, target):
    public = cfg["public"]
    index = target / "pages"
    # (forward PORT UPSTREAM) for tcp/ files: raw TCP on every bind address.
    # Snippets used inside global options must be defined before that block.
    listen = [f"[{a}]" if ":" in a and not a.startswith("[") else a for a in cfg["bind"]] or [""]
    out = ["# import forward PORT UPSTREAM (in tcp/*.caddy)", "(forward) {",
           "\t" + " ".join(f"{a}:{{args[0]}}" for a in listen) + " {",
           "\t\troute {", "\t\t\tproxy {args[1]}", "\t\t}", "\t}", "}", ""]
    out += ["{", f"\tadmin {ADMIN}", "\tskip_install_trust", "\tgrace_period 10s",
            f"\thttp_port {cfg['http_port']}", f"\thttps_port {cfg['https_port']}"]
    if cfg["bind"]:
        out.append("\tdefault_bind " + " ".join(cfg["bind"]))
    if cfg["tls_internal"]:
        out.append("\tlocal_certs")
    elif token():
        out.append("\tacme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}")
    if tcp:
        out.append("\tlayer4 {")
        out += [f"\t\timport {quote(item['path'])}" for item in tcp]
        out.append("\t}")
    out += ["\tlog default {", "\t\toutput stderr", "\t\tformat console", "\t}",
            "\tlog file {", f"\t\toutput file {quote(LOG)} {{", "\t\t\troll_size 5MiB", "\t\t\troll_keep 3",
            "\t\t}", "\t\tformat json", "\t}", "}", ""]

    # (site NAME { directives }) and (proxy NAME UPSTREAM), as in site files.
    out += ["(site) {", f"\t{{args[0]}}.{public} {{", "\t\t{block}", "\t}", "}", "",
            "# import proxy NAME UPSTREAM", "(proxy) {", "\timport site {args[0]} {",
            "\t\treverse_proxy {args[1]}", "\t}", "}", ""]
    # A relay on another box reaches its loopback-only services: the port travels in a
    # header (the relay trusts only this proxy); relay_files drops it (static folder by Host).
    # Every relay snippet sets or removes BOTH relay headers, so a client can never
    # pass its own X-Hq-Relay-Port/Root through to the relay. The relay is a pass-through
    # hop: flush every write, so streams (SSE, long polls) aren't held back here.
    if cfg["relay"]:
        upstream_port = [f"\treverse_proxy {cfg['relay']} {{", "\t\theader_up X-Hq-Relay-Port {args[0]}",
                         "\t\theader_up -X-Hq-Relay-Root", "\t\tflush_interval -1", "\t}"]
        upstream_files = [f"\treverse_proxy {cfg['relay']} {{", "\t\theader_up -X-Hq-Relay-Port",
                          "\t\theader_up -X-Hq-Relay-Root", "\t\tflush_interval -1", "\t}"]
        upstream_root = [f"\treverse_proxy {cfg['relay']} {{", "\t\theader_up X-Hq-Relay-Root {args[0]}",
                         "\t\theader_up -X-Hq-Relay-Port", "\t\tflush_interval -1", "\t}"]
    else:
        upstream_port = upstream_files = upstream_root = ['\trespond "relay not configured (HQ_RELAY)" 502']
    out += ["# import relay NAME PORT / relay_upstream PORT / relay_files NAME", "(relay_upstream) {"] + upstream_port + ["}", "",
            "(relay) {", "\timport site {args[0]} {", "\t\timport relay_upstream {args[1]}", "\t}", "}", "",
            "(relay_files_upstream) {"] + upstream_files + ["}", "",
            "(relay_files) {", "\timport site {args[0]} {", "\t\timport relay_files_upstream", "\t}", "}", "",
            "# import relay_root FOLDER (inside a site block): files from that folder on the relay's box",
            "(relay_root) {"] + upstream_root + ["}", ""]

    # The sites page, the unknown-name page and HTTP->HTTPS redirects.
    out += ["import site sites {"]
    for name in ("status.json", "dns.json", "sync.json"):
        out += [f"\thandle /{name} {{", "\t\theader Cache-Control no-store",
                f"\t\troot * {quote(STATE)}", "\t\tfile_server", "\t}"]
    out += ["\thandle {", f"\t\troot * {quote(index)}", "\t\tfile_server", "\t}", "}", ""]
    unknown = ["\troot * " + quote(index), "\trewrite * /404.html", "\tfile_server {", "\t\tstatus 404", "\t}"]
    # One wildcard per host: a single certificate covers every service on that host
    # (Caddy 2.10+ prefers an applicable wildcard).
    for prefix in ["*"] + [f"*.{host}" for host in sorted(host_names)]:
        out += [f"{prefix}.{public} {{"] + unknown + ["}", "",
                f"http://{prefix}.{public} {{", "\tredir https://{host}{uri} permanent", "}", ""]
    for item in sites:
        out += [f"# {item['source']}", f"import {quote(item['path'])}", ""]
    return "\n".join(out) + "\n"


def urls(cfg, name):
    return [f"https://{name}.{cfg['public']}"]


def hosts(sites):
    """Hosts named by <service>.<host> site files, e.g. dockge.nas -> nas."""
    found = {item["name"].split(".", 1)[1] for item in sites if "." in item["name"]}
    return sorted(h for h in found if DOMAIN.match(h))


def build(target, cfg, source, sync):
    """Write a complete configuration into target from a config checkout (its site and
    tcp files are copied, so the running config never reads a newer checkout)."""
    if target.exists():
        shutil.rmtree(target)
    for sub in ("sites", "tcp"):
        (target / sub).mkdir(parents=True)
        for path in sorted((source / sub).glob("*.caddy")) if (source / sub).is_dir() else []:
            shutil.copy2(path, target / sub / path.name)
    if records_file(source):
        (target / "dns").mkdir()
        shutil.copy2(records_file(source), target / "dns" / "records")
    (target / "pages").mkdir()
    sites, skipped, tcp = collect(target)
    host_names = set(hosts(sites)) | dns_hosts(cfg)
    (target / "Caddyfile").write_text(caddyfile(cfg, sites, tcp, host_names, target))
    # Normalise formatting so Caddy does not warn about it on every start.
    subprocess.run(["caddy", "fmt", "--overwrite", str(target / "Caddyfile")], capture_output=True)
    for name, content in pages(cfg, sites, skipped, tcp, sync).items():
        (target / "pages" / name).write_text(content)
    active = lambda item: dict(item, path=item["path"].replace(str(target), str(ACTIVE), 1))
    return {"version": VERSION, "public": cfg["public"], "hosts": sorted(host_names), "sites": [active(s) for s in sites],
            "skipped": skipped, "tcp": [active(t) for t in tcp]}


def caddy(*args):
    return subprocess.run(["caddy", *args], env=caddy_env(), capture_output=True, text=True)


def caddy_error(output, directory):
    """The readable part of Caddy's error output, with paths relative to the config."""
    message = output.strip()[-300:]
    for line in reversed(output.splitlines()):
        if line.startswith("Error:"):
            message = line[6:].strip()
            break
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if isinstance(entry, dict) and entry.get("level") == "error":
            message = entry.get("error") or entry.get("msg") or message
            break
    return message.replace(str(directory) + "/", "")


def validate(directory, caddy_file="Caddyfile"):
    result = caddy("validate", "--config", str(directory / caddy_file), "--adapter", "caddyfile")
    return result.returncode == 0, caddy_error(result.stderr or result.stdout, directory)


def braces(text):
    """Count { and } outside comments and quoted strings. Caddy accepts a file that ends
    inside a block, but then it swallows whatever is imported after it."""
    opened = closed = 0
    for line in text.splitlines():
        quoted = False
        for char in line:
            if char == '"':
                quoted = not quoted
            elif not quoted and char == "#":
                break
            elif not quoted:
                opened += char == "{"
                closed += char == "}"
    return opened, closed


def culprits(directory):
    """Validate each site and tcp file on its own (the others left out) to name the broken ones."""
    text = (directory / "Caddyfile").read_text()
    files = [p for sub in ("sites", "tcp") for p in sorted((directory / sub).glob("*.caddy"))]
    found = []
    for path in files:
        opened, closed = braces(path.read_text())
        if opened != closed:
            found.append(f"{path.relative_to(directory)}: unbalanced braces ({opened} '{{' vs {closed} '}}')")
            continue
        others = [f'import "{other}"' for other in files if other != path]
        probe = "\n".join(line for line in text.splitlines() if line.strip() not in others) + "\n"
        (directory / "probe.Caddyfile").write_text(probe)
        ok, message = validate(directory, "probe.Caddyfile")
        if not ok:
            found.append(f"{path.relative_to(directory)}: {message}")
    (directory / "probe.Caddyfile").unlink(missing_ok=True)
    return found


def running():
    try:
        with urllib.request.urlopen(f"http://{ADMIN}/config/", timeout=2):
            return True
    except OSError:
        return False


BUILD_LOCK = threading.Lock()


def apply(cfg, source, sync):
    """Build from source, validate, then make it the running config. On any failure the
    previous configuration keeps running. Returns (ok, message)."""
    with BUILD_LOCK:
        report = build(CANDIDATE, cfg, source, sync)
        dns = ensure_dns(cfg, hosts(report["sites"]))
        for item in dns:
            if item["state"].startswith("error") or item["state"] == "created":
                log(f"DNS {item['name']}: {item['state']}")
        ok, message = validate(CANDIDATE)
        if not ok:
            message = "; ".join(culprits(CANDIDATE)) or message
        record_errors = parse_records(records_file(CANDIDATE).read_text(), cfg["public"])[1] if records_file(CANDIDATE) else []
        if record_errors:
            ok, message = False, "; ".join(([message] if not ok else []) + ["dns/records: " + "; ".join(record_errors)])
        if not ok:
            shutil.rmtree(CANDIDATE, ignore_errors=True)
            return False, message
        previous = STATE / "previous"
        shutil.rmtree(previous, ignore_errors=True)
        if ACTIVE.exists():
            ACTIVE.rename(previous)
        CANDIDATE.rename(ACTIVE)
        caddy_file = ACTIVE / "Caddyfile"
        caddy_file.write_text(caddy_file.read_text().replace(str(CANDIDATE), str(ACTIVE)))
        if running():
            result = caddy("reload", "--config", str(caddy_file), "--adapter", "caddyfile", "--address", ADMIN)
            if result.returncode != 0:
                # Caddy kept its old config: put the matching files back.
                shutil.rmtree(ACTIVE, ignore_errors=True)
                if previous.exists():
                    previous.rename(ACTIVE)
                return False, "reload failed: " + (result.stderr.strip().splitlines() or ["?"])[-1][-400:]
        shutil.rmtree(previous, ignore_errors=True)
        report["dns"] = dns
        write_json(REPORT, report)
        return True, ""


def rebuild(cfg):
    """Apply the active snapshot again (settings or DNS hosts changed)."""
    return apply(cfg, ACTIVE if (ACTIVE / "Caddyfile").exists() else STATE / "empty", load_json(SYNC))


